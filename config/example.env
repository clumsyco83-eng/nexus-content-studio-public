# Never commit real secrets. Copy this file locally to .env.

# Runtime safety
NEXUS_MODE=approval
ACTIVE_BRAND=curious-grit
NEXUS_ALLOW_PAID_GENERATION=false
NEXUS_MONTHLY_MEDIA_BUDGET_USD=50

# Durable storage
# Keep JSON until npm run verify:sqlite and the migration both pass on the real laptop.
NEXUS_STORAGE_DRIVER=json
NEXUS_JSON_DATABASE_FILE=data/nexus-db.json
NEXUS_SQLITE_DATABASE_FILE=data/nexus.db

# Higgsfield uses CLI/MCP browser authentication; no API key is stored here.
HIGGSFIELD_ENABLED=false
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# Direct video/image providers
RUNWAYML_API_SECRET=
FAL_KEY=

# Voice
VOICE_PROVIDER=
VOICE_API_KEY=

# Publishing integrations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
