{
  "name": "nexus-content-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "dashboard": "tsx src/dashboard/server.ts",
    "guardian:check": "tsx src/guardian/guardian.ts",
    "guardian:watchdog": "tsx src/guardian/watchdog.ts",
    "guardian:watchdog:once": "tsx src/guardian/watchdog.ts --once",
    "projects:status": "tsx src/projects/project-control.ts",
    "render:carousel-demo": "tsx src/rendering/demo-carousel.ts",
    "test:first-production": "tsx src/testing/run-first-production-test.ts",
    "test:provider-readiness": "tsx src/testing/provider-readiness.ts",
    "verify:commerce": "tsx src/testing/commerce-agent.ts",
    "verify:controls": "tsx src/testing/operational-controls.ts",
    "verify:model-routing": "tsx src/testing/model-routing.ts",
    "verify:model-promotion": "tsx src/testing/model-promotion.ts",
    "verify:claude-runtime-evidence": "tsx src/testing/claude-runtime-evidence.ts",
    "verify:runtime-attestation": "tsx src/testing/runtime-attestation.ts",
    "verify:claude-tool-envelope": "tsx src/testing/claude-tool-envelope.ts",
    "verify:claude-skill-admission": "tsx src/testing/claude-skill-admission.ts",
    "verify:secure-claude-executor": "tsx src/testing/secure-claude-executor.ts",
    "verify:claude-runtime-observation": "tsx src/testing/claude-runtime-observation.ts",
    "verify:core-specialist-candidates": "tsx src/testing/core-specialist-candidates.ts",
    "core-specialists:capabilities": "tsx src/capabilities/core-specialist-candidates-cli.ts",
    "verify:intelligence-routing": "tsx src/testing/intelligence-routing.ts",
    "verify:capabilities": "tsx src/testing/capability-readiness.ts",
    "verify:capability-evidence": "tsx src/testing/capability-evidence-drift.ts",
    "verify:capability-recorder": "tsx src/testing/capability-evidence-recorder.ts",
    "capability:evidence": "tsx src/capabilities/evidence-recorder-cli.ts",
    "capability:claude-runtime-observation": "tsx src/capabilities/claude-runtime-observation-cli.ts",
    "verify:goals": "tsx src/testing/goal-engine.ts",
    "verify:goal-task-approvals": "tsx src/testing/goal-task-approvals.ts",
    "verify:emergency-stop": "tsx src/testing/emergency-stop.ts",
    "verify:powershell-broker": "tsx src/testing/powershell-broker.ts && tsx src/testing/powershell-broker-v2.ts && tsx src/testing/powershell-broker-trusted-git.ts",
    "verify:remote-github": "tsx src/testing/github-remote-transport.ts && tsx src/testing/github-remote-maintenance.ts",
    "remote:github:once": "tsx src/remote-transport/worker.ts --once",
    "remote:github:worker": "tsx src/remote-transport/worker.ts",
    "verify:goal-task-verifier": "tsx src/testing/goal-task-verifier.ts",
    "verify:stuck": "tsx src/testing/stuck-detector.ts",
    "verify:replan": "tsx src/testing/replan-coordinator.ts",
    "verify:resume": "tsx src/testing/resume-manager.ts",
    "verify:runtime-cycle": "tsx src/testing/runtime-cycle.ts",
    "verify:secure-bridge-runtime": "tsx src/testing/secure-bridge-runtime.ts && npm run verify:claude-runtime-observation",
    "secure-bridge:cycle": "powershell -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File scripts/run-secure-bridge-cycle.ps1",
    "secure-bridge:live:setup": "tsx src/testing/secure-bridge-live-regression.ts setup",
    "secure-bridge:live:status": "tsx src/testing/secure-bridge-live-regression.ts status",
    "secure-bridge:live:cleanup": "tsx src/testing/secure-bridge-live-regression.ts cleanup",
    "verify:goal-dashboard": "tsx src/testing/goal-dashboard.ts",
    "verify:collaboration-e2e": "tsx src/testing/collaboration-loop-e2e.ts",
    "verify:openai-strategy": "tsx src/testing/openai-strategy-adapter.ts",
    "smoke:openai-live": "tsx src/testing/openai-live-smoke.ts",
    "smoke:claude-live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-claude-live.ps1",
    "smoke:claude-live:record": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-claude-live.ps1 -RecordRuntimeObservation",
    "verify:system": "tsx src/testing/system-health.ts",
    "verify:sqlite": "tsx src/testing/sqlite-storage.ts",
    "verify:secure-bridge-laptop": "powershell -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File scripts/windows-secure-bridge-verify.ps1",
    "verify:laptop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-laptop-verify.ps1 && npm run verify:secure-bridge-laptop && npm run verify:powershell-broker && npm run verify:remote-github",
    "preflight:priority-completion": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/priority-completion-preflight.ps1",
    "storage:migrate:sqlite": "tsx src/storage/migrate-json-to-sqlite.ts",
    "storage:export:json": "tsx src/storage/export-sqlite-to-json.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
