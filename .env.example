# Nexus mode: approval | autopilot
NEXUS_MODE=approval

# Spending safety. Paid generation must remain disabled until explicitly enabled locally.
NEXUS_ALLOW_PAID_GENERATION=false
NEXUS_MONTHLY_MEDIA_BUDGET_USD=50
NEXUS_MONTH_TO_DATE_MEDIA_SPEND_USD=0
# Optional hard cap for a single paid generation job. Leave blank to rely on the monthly cap.
NEXUS_MEDIA_PER_JOB_CAP_USD=
NEXUS_BUDGET_CURRENCY=USD

# Dashboard / local control plane
NEXUS_DASHBOARD_HOST=127.0.0.1
NEXUS_DASHBOARD_PORT=8787
NEXUS_DASHBOARD_TOKEN=

# Durable storage
# Keep JSON selected until the SQLite verification + migration steps pass on the real laptop.
NEXUS_STORAGE_DRIVER=json
NEXUS_JSON_DATABASE_FILE=data/nexus-db.json
NEXUS_SQLITE_DATABASE_FILE=data/nexus.db
# Backward-compatible JSON alias used by older local configs.
NEXUS_DATABASE_FILE=data/nexus-db.json

# Nexus Guardian / Watchdog
NEXUS_GUARDIAN_HEALTH_URL=http://127.0.0.1:8787/api/health
NEXUS_GUARDIAN_REPORT_DIR=data/guardian
NEXUS_GUARDIAN_MAX_REPORT_AGE_MS=86400000
NEXUS_GUARDIAN_STALE_JOB_MS=86400000
NEXUS_WATCHDOG_INTERVAL_MS=300000
NEXUS_WATCHDOG_FAILURE_THRESHOLD=2
NEXUS_WATCHDOG_AUTO_RESTART=false
# Example only. Configure locally before enabling auto-restart.
NEXUS_WATCHDOG_RESTART_COMMAND=

# AI / research providers
# Secrets stay blank in Git. Configure them only in the approved local runtime secret environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI strategy / replanning adapter.
# Choose and pin the API model deliberately; NEXUS fails closed if this is blank.
NEXUS_OPENAI_STRATEGY_MODEL=
# Production promotion follows MODEL-PROMOTION-GATE.md; live execution additionally verifies provider-reported identity.
NEXUS_OPENAI_EXPECTED_RESOLVED_MODEL=
NEXUS_OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
NEXUS_OPENAI_TIMEOUT_MS=60000
NEXUS_OPENAI_MAX_OUTPUT_TOKENS=2000
NEXUS_OPENAI_MAX_INPUT_BYTES=64000
# Required when a Goal Contract supplies maxCostUsd. Keep these synchronized with the chosen model's current API pricing.
# NEXUS refuses cost-budgeted OpenAI calls when rates are absent rather than assuming stale pricing.
NEXUS_OPENAI_INPUT_USD_PER_1M=
NEXUS_OPENAI_OUTPUT_USD_PER_1M=

# Cost-aware Claude routing. Model identifiers remain configurable so provider SKU changes do not require code changes.
NEXUS_CLAUDE_DEFAULT_MODEL=sonnet
NEXUS_CLAUDE_ESCALATION_MODEL=opus
# Production READY runtime evidence must record exact provider-resolved identities, not floating aliases.
NEXUS_CLAUDE_EXPECTED_DEFAULT_RESOLVED_MODEL=
NEXUS_CLAUDE_EXPECTED_ESCALATION_RESOLVED_MODEL=
# Exact `claude --version` string used by the most recent live routing/skill/safety evaluation.
NEXUS_CLAUDE_EXPECTED_CODE_VERSION=
# Manual bounded read-only Claude runtime smoke. Disabled unless the exact local opt-in is supplied.
NEXUS_CLAUDE_LIVE_SMOKE=
NEXUS_CLAUDE_LIVE_SMOKE_MODEL=
NEXUS_CLAUDE_LIVE_SMOKE_EXPECTED_RESOLVED_MODEL=
# Default smoke cost ceiling is $0.10; hard maximum enforced by the verifier is $0.50.
NEXUS_CLAUDE_LIVE_SMOKE_MAX_COST_USD=0.10
# Bounded turn ceiling: never unlimited. Current policy allows up to 40 turns.
NEXUS_CLAUDE_MAX_TURNS=40
# Retry Sonnet after verifier feedback, then escalate only after repeated genuine verification failures.
NEXUS_CLAUDE_REPAIR_ATTEMPTS_BEFORE_ESCALATION=2
NEXUS_CLAUDE_MAX_REPAIR_ATTEMPTS=5
NEXUS_CLAUDE_MAX_ESCALATIONS=1

# Video / image / voice providers
# Higgsfield is authenticated through its CLI/MCP account flow, not a repo-stored API key.
HIGGSFIELD_ENABLED=false
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
RUNWAYML_API_SECRET=
FAL_KEY=

# YouTube OAuth + exact channel mapping
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Meta OAuth + exact account/page mapping
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# LinkedIn live transport remains disabled until the current account/API flow is validated.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Storage/database (future cloud migration remains optional)
DATABASE_URL=
STORAGE_PATH=./data

# Never commit real secrets, session cookies, OAuth tokens, or refresh tokens to GitHub.
